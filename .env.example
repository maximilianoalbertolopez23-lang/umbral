# Copiá este archivo a .env.local y completá los valores. Guía completa: docs/CONFIGURACION.md

# Postgres. Local (npm run db:local) o la cadena con pooler de Neon.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Secreto de sesiones (mínimo 32 caracteres):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# URL pública de la app (obligatoria en producción).
BETTER_AUTH_URL=http://localhost:3000

# Correo (obligatorio en producción). Sin esto, en desarrollo los enlaces se imprimen en la consola del servidor.
# SMTP_URL=smtps://usuario%40dominio.com:contrasena@smtp.ejemplo.com:465
# MAIL_FROM="UMBRAL <no-responder@tu-dominio.com>"
